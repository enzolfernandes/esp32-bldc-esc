\contentsline {figure}{\numberline {22}{\ignorespaces Regime transitório ou de rampa documentado via exportação CSV da dashboard Wi-Fi: série temporal de RPM estimado obtida sem captura serial USB durante o ensaio de potência.}}{94}{figure.caption.33}%
\contentsline {figure}{\numberline {23}{\ignorespaces Medição do \textit {offset} de repouso do amplificador INA240 (Canal A) com motor desconectado e corrente nula.}}{101}{figure.caption.36}%
\contentsline {figure}{\numberline {24}{\ignorespaces Oscilograma dos sinais de \textit {gate} complementares do braço A ($AH$ e $AL$) com destaque para o intervalo de \textit {dead-time} medido pelos cursores temporais nas duas transições de comutação.}}{105}{figure.caption.38}%
\contentsline {figure}{\numberline {25}{\ignorespaces Oscilograma do evento de disparo da proteção OCP em \textit {hardware}: sequência temporal entre o cruzamento do limiar de sobrecorrente (Ch1), a atuação do nó \textit {OC Trip} (Ch2), o bloqueio do sinal PWM de \textit {gate} (Ch3) e a desativação do \textit {driver} IR2110 via \textit {shutdown} (Ch4).}}{106}{figure.caption.39}%
\contentsline {figure}{\numberline {26}{\ignorespaces Ondulação de tensão (\textit {ripple}) do barramento DC medida em acoplamento AC durante chaveamento em vazio a $20\,\text {kHz}$: a componente contínua de $12\,\text {V}$ é bloqueada pelo acoplamento AC, evidenciando exclusivamente a componente de alta frequência residual após a filtragem pelo banco capacitivo de $940\,\mu \text {F}$.}}{107}{figure.caption.40}%
\contentsline {figure}{\numberline {27}{\ignorespaces Correntes de fase durante a sequência completa de partida do motor A2212/10T: fase de alinhamento estático ($500\,\text {ms}$, apenas Fases A e B energizadas), rampa de aceleração em malha aberta (\breakabletexttt {RUN\_OPEN}) e eventual transição para malha de velocidade (\breakabletexttt {RUN\_SPEED}), evidenciando o padrão trapezoidal de comutação de seis passos.}}{110}{figure.caption.41}%
\contentsline {figure}{\numberline {28}{\ignorespaces Resposta dinâmica do controlador PI de corrente a um degrau de referência: a referência rampeada pelo \textit {slew limiter} a $2\,\text {A/s}$ (curva tracejada) e a corrente medida pelo INA240 (curva sólida), capturadas via telemetria serial a $115200\,\text {baud}$.}}{112}{figure.caption.42}%
\contentsline {figure}{\numberline {29}{\ignorespaces Evolução temporal da corrente de fase, do ciclo de trabalho e do estado da FSM durante o evento de travamento mecânico do eixo: a sequência de saturação do PI, detecção de \textit {stall} e entrada em falha (\breakabletexttt {ESC\_STATE\_FAULT}) registrada via telemetria serial a $115200\,\text {baud}$.}}{114}{figure.caption.43}%
