---
config:
  theme: base
  themeVariables:
    fontSize: 14px
    fontFamily: Arial, Helvetica, sans-serif
  layout: dagre
---
flowchart TB

    subgraph PANEL2["Visão operacional resumida · equivalente ao Fluxo A"]
        direction TB

        START(["▶ INÍCIO<br/>Alimentação / reset"])

        P1["hal_motor_init · Serial · esc_radio_quiet<br/>Wi-Fi/HMI opcional · fsm_system_init · reclaim SD"]
        D1{"Inicialização<br/>OK?"}

        EST["Estado ESC<br/>IDLE · RUNNING · FAULT"]

        LOOP(["Ciclo principal ~20 ms"])

        P4["Ler Serial HMI ou PS4 · fsm_system_tick"]
        D_FAULT{"Estado<br/>FAULT?"}
        D6{"Clear fault?"}
        P8["Clear fault → IDLE"]

        D_IN{"Entrada<br/>ativa?"}
        P5["Desarmar motor → IDLE"]
        D3{"Comando<br/>arm?"}
        D4{"Pode armar?<br/>IDLE · sem UVLO/OC"}
        P6["Armar · partida → RUNNING"]
        D_RUN{"Estado<br/>RUNNING?"}
        P7["Regulação PI e comutação 6-step<br/>malha aberta · padrão ZCD=0"]
        D5{"Falha crítica?<br/>OCP · UVLO · Stall"}
        P3["FAULT · desarmar PWM"]
        IO["Telemetria serial 500 ms"]

        START --> P1 --> D1
        D1 -->|Sim · IDLE| EST
        D1 -->|Não| P3 --> EST
        EST --> LOOP

        LOOP --> P4 --> D_FAULT
        D_FAULT -->|Sim| D6
        D6 -->|Sim| P8 --> IO
        D6 -->|Não| IO
        IO --> LOOP

        D_FAULT -->|Não| D_IN
        D_IN -->|Não| P5 --> D3
        D_IN -->|Sim| D3
        D3 -->|Sim| D4
        D4 -->|Sim| P6 --> P7 --> D5
        D4 -->|Não| D_RUN
        D3 -->|Não| D_RUN
        D_RUN -->|Sim| P7 --> D5
        D_RUN -->|Não| IO
        D5 -->|Sim| P3 --> IO
    end

    class START initSt
    class EST idleSt
    class LOOP loopSt
    class P3 faultSt
    class P6 runSt
    class P8 idleSt
    class P1,P4,P5,P7,D1,D_IN,D3,D4,D5,D6,D_FAULT,D_RUN,IO neutral

    classDef initSt fill:#FFE8CC,stroke:#CC8400,stroke-width:3px,color:#000
    classDef idleSt fill:#CCE5FF,stroke:#0078FF,stroke-width:2px,color:#000
    classDef runSt fill:#CCFFCC,stroke:#00AA00,stroke-width:2px,color:#000
    classDef faultSt fill:#FFCCCC,stroke:#CC0000,stroke-width:2px,color:#000
    classDef loopSt fill:#EEEEEE,stroke:#555555,stroke-width:2px,color:#000
    classDef neutral fill:#FFFFFF,stroke:#333,stroke-width:1px,color:#000

    style PANEL2 fill:#E8F4FF,stroke:#0078FF,stroke-width:2px,color:#111111
