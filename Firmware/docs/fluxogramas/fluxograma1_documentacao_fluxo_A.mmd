---
config:
  theme: base
  themeVariables:
    fontSize: 12px
    fontFamily: Arial, Helvetica, sans-serif
  layout: dagre
---
flowchart TB

    subgraph FA["FLUXO A · loop Arduino ~20 ms"]
        direction TB

        START(["▶ INÍCIO<br/>Alimentação / reset"])

        P00["hal_motor_init<br/>SD=HIGH · PWM LOW"]
        P01["Serial 115200 + esc_radio_quiet_init"]
        P02["Wi-Fi AP opcional<br/>BOARD_ENABLE_WIFI_TELEMETRY"]
        P03["PS4 init OU Serial HMI init"]
        P04["fsm_system_init<br/>ADC · LM339 · INA240 · bateria · ISR OC · timer 1 kHz"]
        P05["hal_motor_reclaim_outputs"]
        D01{"Init OK?"}

        P14["Estado → IDLE"]
        F1["enter_fault_state · FAULT"]

        P20["battery_monitor_tick"]
        P21["fsm_system_tick"]
        IO_IN["Entrada: Serial HMI ou PS4<br/>arm · setpoint · clear fault"]
        D_FAULT{"Estado FAULT?"}
        D03{"Clear fault?<br/>Options ou c/C"}
        D04{"OC liberado · sem UVLO?"}
        P23["Clear fault → IDLE"]

        D02{"Entrada ativa?"}
        P22["Desarme se RUNNING"]
        D05{"Comando arm?"}
        D06{"Pode armar?<br/>IDLE sem UVLO/OC"}
        ARM["Armar ESC · RUNNING"]
        D07{"Estado RUNNING?"}
        P24["Desarme"]
        D08{"Troca sentido?"}
        P25["Sentido CW ↔ CCW"]
        P26["Setpoint com slew"]
        IO_OUT["Telemetria serial 500 ms<br/>Wi-Fi se ativo"]

        START --> P00 --> P01 --> P02 --> P03 --> P04 --> P05 --> D01
        D01 -->|Sim| P14 --> P20
        D01 -->|Não| F1 --> P20

        P20 --> P21 --> IO_IN --> D_FAULT

        D_FAULT -->|Sim| D03
        D03 -->|Sim| D04
        D04 -->|Sim| P23 --> IO_OUT
        D04 -->|Não| IO_OUT
        D03 -->|Não| IO_OUT

        D_FAULT -->|Não| D02
        D02 -->|Não| P22 --> D05
        D02 -->|Sim| D05
        D05 -->|Sim| D06
        D06 -->|Sim| ARM --> D07
        D06 -->|Não| D07
        D05 -->|Não| D07
        D07 -->|Sim| P24 --> D08
        D07 -->|Não| IO_OUT
        D08 -->|Sim| P25 --> P26 --> IO_OUT
        D08 -->|Não| P26 --> IO_OUT

        IO_OUT --> P20
    end

    classDef initSt fill:#FFE8CC,stroke:#CC8400,stroke-width:2px,color:#000
    classDef idleSt fill:#CCE5FF,stroke:#0078FF,stroke-width:2px,color:#000
    classDef runSt fill:#CCFFCC,stroke:#00AA00,stroke-width:2px,color:#000
    classDef faultSt fill:#FFCCCC,stroke:#CC0000,stroke-width:2px,color:#000
    classDef neutral fill:#FFFFFF,stroke:#333,stroke-width:1px,color:#000

    class START,P00 initSt
    class P14,P23 idleSt
    class ARM runSt
    class F1 faultSt

    style FA fill:#E8F4FF,stroke:#0078FF,stroke-width:2px,color:#111111
